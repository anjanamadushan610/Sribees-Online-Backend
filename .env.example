# ============================================================================
# SRIBEESonline FastAPI Backend - Environment Configuration
# ============================================================================
# Copy this file to .env and update values for your environment
# For production, use strong secrets and secure credentials

# Application
APP_NAME=SRIBEESonline API
APP_ENV=development  # development | staging | production
DEBUG=true
API_VERSION=v1

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================================================
# Error Tracking & Monitoring (Sentry)
# ============================================================================
# Get DSN from https://sentry.io - Required for production
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ============================================================================
# PostgreSQL Database
# ============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/sribeesonline
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Legacy format (alternative configuration)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=sribeesonline
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# TEMPORARY: with no real OTP delivery (SMS/WhatsApp) wired up yet, setting
# this lets phone OTP verification (both /auth/phone/verify-otp and
# /auth/verify-otp) accept this one fixed code instead of the real one from
# Redis. Leave blank/unset everywhere until you need it; to turn it off again
# just remove this line -- no code change or redeploy needed. Delete this
# setting (and its use in OTPService.verify_otp) once real OTP delivery ships.
# OTP_TEST_BYPASS_CODE=123456

# Email (SMTP)
MAIL_FROM=noreply@sribeesonline.lk
MAIL_FROM_NAME=SRIBEESonline
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# =============================================================================
# Marx IPG Payment Gateway
# =============================================================================
# Sandbox: https://payment.api.dev.marxpos.com | Prod: https://payment.v4.api.marx.lk
MARX_IPG_BASE_URL=https://payment.api.dev.marxpos.com
MARX_IPG_API_KEY=
# Reachable by the SHOPPER'S DEVICE (client-side browser redirect target, not
# called by Marx's servers) -- 10.0.2.2 works for the Android emulator.
MARX_IPG_RETURN_URL=http://10.0.2.2:8000/api/v1/payments/marx/return
MARX_IPG_VALID_TIME_LIMIT_HOURS=2
# Keep false until the mobile app release with the Marx WebView payment flow
# has actually rolled out to users -- see settings.py for why.
MARX_GATEWAY_METHODS_ENABLED=false

# =============================================================================
# Courier Integration (fastapi_backend/docs/COURIER_API.md)
# =============================================================================
# Point at the mock courier (fastapi_backend/mock_courier) for local dev.
COURIER_BASE_URL=http://localhost:9100
COURIER_API_KEY=sribees-mock-courier-key
COURIER_INBOUND_API_KEY=sribees-mock-courier-inbound-key

# Firebase Cloud Messaging (Push Notifications)
FIREBASE_CREDENTIALS_PATH=
FCM_SERVER_KEY=

# CORS (JSON array format)
CORS_ORIGINS=["http://localhost:3001", "http://localhost:19006", "http://localhost:8081"]
FRONTEND_URL=http://localhost:3001

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=3

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# OAuth (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=

# =============================================================================
# Media Storage
#
# The database stores ONLY relative paths (/uploads/categories/x.jpg). The
# absolute URL is composed at serialization time as MEDIA_BASE_URL + path, so
# moving to S3/R2 later is a provider swap plus an env change — no rows to
# rewrite, no migration.
# =============================================================================

# 'local' (disk, default) or 's3' (AWS S3 / Cloudflare R2 / MinIO).
STORAGE_BACKEND=local

# Where the local provider writes. MUST be a mounted volume in production, or
# every upload is destroyed when the container is recreated on the next deploy.
MEDIA_ROOT=/app/media

# URL path the files are served under (StaticFiles mount).
MEDIA_URL_PREFIX=/uploads

# Origin prepended to stored paths to build absolute URLs. Leave blank to serve
# same-origin relative URLs (fine for local dev).
# To migrate to S3 later: set STORAGE_BACKEND=s3 and point this at the bucket/CDN.
MEDIA_BASE_URL=https://api.sribees.com

MEDIA_MAX_UPLOAD_SIZE_MB=5

# =============================================================================
# Gemini AI
#
# Optional. Powers the admin panel's "Suggest Keywords" button (Sinhala/
# Tamil/Singlish/Tamilish search-keyword suggestions per product). Get a free
# key at https://aistudio.google.com/apikey. Leave blank and the button
# just returns a clear "not configured" error — nothing else depends on this.
# =============================================================================
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-flash-latest

# =============================================================================
# Post-deploy smoke test (deploy-backend-ec2.yml step 7c)
# =============================================================================
# The deploy logs in as this admin and checks the analytics endpoints answer
# with real, self-consistent figures before declaring itself successful.
# Defaults to the account migrations/026_seed_full_dataset.sql seeds; set these
# once you change that password, or the deploy will fail on a working service.
SMOKE_ADMIN_EMAIL=superadmin@sribeesonline.lk
SMOKE_ADMIN_PASSWORD=Admin@123
